# Вход через Google — необязательно. Без ключей кнопка Google не показывается.
# Redirect URI в Google Cloud: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ИИ-разбор (OpenAI API)
OPENAI_API_KEY=
