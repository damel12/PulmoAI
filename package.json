{
  "name": "pulmoai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:start": "pg_ctl -D .pgdata -o \"-p 5439 -k /tmp -c listen_addresses=localhost\" -l .pgdata/server.log start",
    "db:stop": "pg_ctl -D .pgdata stop",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.mts"
  },
  "dependencies": {
    "better-auth": "^1.7.6",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "openai": "^7.23.0",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
